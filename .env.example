# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# Supabase project reference (the subdomain of your project URL).
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon / publishable key.
# NOTE: this key is public by design — it ships in the client bundle and is
# safe to expose. Row Level Security is what protects your data, not this key.
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Injected automatically at build time by the Vite plugin (see vite.config.ts).
# Leave unset for local development.
# VITE_BUILD_ID=""
